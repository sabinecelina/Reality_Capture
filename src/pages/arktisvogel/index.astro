---
import { getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const project = await getEntry('projects', 'arktisvogel');
if (!project) throw new Error('Missing projects/arktisvogel.md');
const { Content } = await project.render();
---

<PageLayout title={project.data.title} description={project.data.teaser}>
  <article class="max-w-measure">
    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-semibold text-gray-900 dark:text-gray-100 mb-3">
        {project.data.title}
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">{project.data.teaser}</p>
    </header>
    <img
      src="/assets/projects/arktisvogel-feature.png"
      alt="Adipöser Arktisvogel: Das Partyspiel zum Kennenlernen. 400+ Fragen, rate, was die anderen sagen."
      class="w-full rounded-lg mb-8"
    />
    <div class="prose prose-gray dark:prose-invert max-w-none">
      <Content />
    </div>
  </article>
</PageLayout>
