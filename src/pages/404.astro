---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Page Not Found" description="The page you were looking for does not exist.">
  <div class="flex flex-col items-center justify-center py-20 text-center">
    <p class="text-8xl font-semibold text-brand-200 dark:text-brand-900 mb-4" aria-hidden="true">404</p>
    <h1 class="text-3xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Page not found</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8 max-w-md">
      The page you were looking for doesn't exist or may have moved. If you followed an old blog link, it has been relocated to <a href="/blog/">/blog/</a>.
    </p>
    <a href="/" class="btn btn-primary">
      ← Go Home
    </a>
  </div>
</PageLayout>
